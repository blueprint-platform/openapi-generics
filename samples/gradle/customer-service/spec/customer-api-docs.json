            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ServiceResponseCustomerDto"
                }
              }
            },
            "description" : "Customer found"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Customer not found"
          }
        },
        "tags" : [ "Customers" ]
      }
    }
  },
